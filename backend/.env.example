ADMIN_USERNAME=gallery-admin
ADMIN_PASSWORD=replace-with-a-long-random-password
NODE_ENV=development
PORT=5001
# Set this to the exact browser origin serving the gallery.
FRONTEND_ORIGIN=http://localhost:3000
# For a frontend on a different site, use SameSite=None only with HTTPS in production.
ADMIN_COOKIE_SAME_SITE=Strict
# Optional persistent album JSON path. Defaults to backend/src/data/gallery.json.
GALLERY_DATA_PATH=